{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "react-native": {
    "messaging_auto_init_enabled": true,
    "messaging_android_notification_channel_id": "practicum_updates"
  }
}
